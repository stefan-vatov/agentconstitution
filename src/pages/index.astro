---
import { ArrowRight } from "@lucide/astro";
import ConstitutionExhibit from "../components/ConstitutionExhibit.astro";
import LawSpecimen from "../components/LawSpecimen.astro";
import PossibilityTree from "../components/PossibilityTree.astro";
import RatifiedSeal from "../components/RatifiedSeal.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Agent Constitution — write the law your agents build under";
const pageDescription =
  "Your project’s founding judgment, written as a ratified CONSTITUTION.md that AI coding agents load, cite, and are judged against. Three portable skills. Works in any harness. No quick mode.";

const anatomy = [
  {
    name: "Preamble",
    copy: "Why the project exists — what the world would lose if it disappeared tomorrow. Not a feature list.",
  },
  {
    name: "Founding principles",
    copy: "Five to nine values, each with a stated rejection. A principle that rejects nothing guides nothing.",
  },
  {
    name: "Growth directives",
    copy: "Vectors, not roadmaps. Where the project should grow — “toward X” — without prescribing the route.",
  },
  {
    name: "Boundaries",
    copy: "What the project will never become. Each one zeroes out an entire region of possible futures.",
  },
  {
    name: "Tension pairs",
    copy: "Named trade-offs with a stated lean: “X over Y — but never at the cost of Z.” Where wide distributions live.",
  },
  {
    name: "Amendments",
    copy: "Who holds the pen, and by what deliberate act it moves. For agents there is no process — only the text.",
  },
];

const scenarios = [
  ["01-network-pressure", "unlawful effect inside a useful request"],
  ["02-order-vs-law", "a direct order to cross a boundary"],
  ["03-decide-steering", "high-level choice, direction at stake"],
  ["04-ritual-discipline", "gates and footers under long work"],
  ["05-quickmode-refusal", '"just generate it, skip the questions"'],
  ["06-lawful-baseline", "plain work — no over-refusal allowed"],
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <SiteHeader />
  <main id="main">
    <section class="hero shell">
      <div class="hero-copy">
        <span class="mono-label">Project-level governance for AI coding agents</span>
        <h1>Write the <em>law</em> your agents build under.</h1>
        <p class="lede prose">
          Agents rarely wreck a project with absurd choices. They drift it with
          defensible ones — locally correct, collectively fatal. Agent
          Constitution captures the judgment that makes your project yours in a
          ratified <strong>CONSTITUTION.md</strong>: law agents load before they
          act, cite when they choose, and are judged against when the work is
          done.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#adopt">
            Install the skills
            <ArrowRight size={15} />
          </a>
          <a class="btn btn-ghost" href="/how-it-works">Read the mechanism</a>
        </div>
        <p class="hero-facts">
          <span>Three portable skills</span>
          <span>Claude Code / Codex / Pi</span>
          <span>No quick mode</span>
        </p>
      </div>

      <ConstitutionExhibit />
    </section>

    <LawSpecimen />

    <section id="drift" class="article shell" aria-label="The drift problem">
      <div class="article-rule"><span><b>Art. I</b> — The drift</span></div>

      <h2>Drift is made of <em>defensible</em> choices.</h2>

      <p class="statement">
        Every project is started for reasons — motivations that differentiate
        it, decisions meant to make it win.
      </p>
      <p class="statement quiet">
        An agent working inside one corner of the codebase cannot see those
        reasons. It makes the locally optimal choice. Each model drifts the
        project in its own direction, because the pull comes from training and
        weights, not from the work.
      </p>

      <blockquote class="pull-quote">
        <p>
          The end state is always the same. Functional mediocrity: the average
          of all the weights.
        </p>
        <cite>— Constitution of this repository, preamble</cite>
      </blockquote>

      <div class="drift-kicker">
        <p class="prose">
          Rules files can’t stop this. Rules operate at the leaves: formatting,
          naming, which tool to call. The choices that decide what a project
          becomes branch at the trunk — architecture, scope, dependencies,
          product direction. Every step passes review on its own terms while
          the sum walks away from the point.
        </p>
        <p class="sharp">
          An agent can follow every rule in the rules file and still violate
          the project.
        </p>
      </div>
    </section>

    <section id="document" class="article shell" aria-label="What a constitution is">
      <div class="article-rule"><span><b>Art. II</b> — The document</span></div>

      <div class="split">
        <div class="split-lead">
          <h2>A constitution prunes the tree <em>at the trunk.</em></h2>
          <p class="prose">
            One document above the rules files: direction, never details.
            “A performance-first application” belongs in it; “under 500ms” does
            not. Six sections, each doing
            <a class="inline-link" href="/how-it-works">distribution work</a>
            on the futures your agents can reach.
          </p>
          <p class="prose">
            Every sentence has to earn its place by rejecting something real.
            A principle nobody could disagree with steers nothing; the
            ratification gates are built to catch exactly that.
          </p>
        </div>

        <div class="anatomy" role="list">
          {anatomy.map(({ name, copy }) => (
            <article role="listitem">
              <h3>{name}</h3>
              <p>{copy}</p>
            </article>
          ))}
        </div>
      </div>

      <PossibilityTree />

      <div class="binds">
        <div>
          <h3>It binds like physics, not like statutes.</h3>
          <p>
            For the humans who hold the pen, the constitution is legislation.
            For agents it is physics: no court, no interpretation, no appeal —
            and no exception for urgency, seniority, or “just this once.” The
            law outranks every instruction, including yours.
          </p>
        </div>
        <div>
          <h3>It removes branches. It never picks yours.</h3>
          <p>
            A broad law is not a vague law. Options that cross a boundary stop
            existing, however locally optimal; among the branches that remain,
            the agent optimizes freely. If no lawful option remains, it halts
            and tells you — that, too, is the system working.
          </p>
        </div>
      </div>
    </section>

    <section id="lifecycle" class="article shell" aria-label="The three skills">
      <div class="article-rule"><span><b>Art. III</b> — The lifecycle</span></div>

      <h2>You write the law once. The law governs <em>continuously.</em></h2>
      <p class="prose" style="margin-bottom: 40px;">
        Three portable skills cover the whole life of the document — plain
        <code>SKILL.md</code> files, no framework, no vendor. One is for the
        human who writes it. The other two are for the agents who live under
        it.
      </p>

      <ol class="lifecycle">
        <li>
          <span class="step-no" aria-hidden="true">i.</span>
          <div>
            <h3>Ratify</h3>
            <span class="skill-path">skills/write-constitution</span>
          </div>
          <div class="step-copy">
            <p>
              A Socratic interview draws out what you actually believe. It
              starts from signals in your codebase, pushes on your answers with
              counterexamples, and tests every candidate principle against
              adversarial gates built to catch anything too vague to steer a
              model. You approve every section — the skill never writes a value
              you didn’t state — and then it wires the result into AGENTS.md
              and CLAUDE.md, because a constitution nobody loads is a poster.
            </p>
            <span class="step-out">→ <b>CONSTITUTION.md</b> ratified · digest wired into AGENTS.md + CLAUDE.md</span>
          </div>
        </li>
        <li>
          <span class="step-no" aria-hidden="true">ii.</span>
          <div>
            <h3>Decide</h3>
            <span class="skill-path">skills/constitution-decide</span>
          </div>
          <div class="step-copy">
            <p>
              Before any high-level choice, the agent splits the request into
              effects and discards the ones that cross a boundary, citing the
              exact clause. The lawful survivors get ranked by direction, and
              the agent optimizes freely among them. One forbidden effect never
              erases its lawful siblings — a mixed request keeps its useful
              work.
            </p>
            <span class="step-out">→ effect ledger · unlawful branches discarded with the clause quoted</span>
          </div>
        </li>
        <li>
          <span class="step-no" aria-hidden="true">iii.</span>
          <div>
            <h3>Verify</h3>
            <span class="skill-path">skills/constitution-verify</span>
          </div>
          <div class="step-copy">
            <p>
              After the work comes the gate: every effect is judged against the
              ratified text, one ledger row each, PASS or FAIL with citations.
              No scores, no averaging, no partial credit. Agents run it
              unprompted on their own work and on each other’s — a failing peer
              gets challenged, clause against clause, until the most
              constitutionally pure version wins. Nothing escapes judgment, and
              no human sits in that loop.
            </p>
            <span class="step-out">→ <b>Constitution gate: PASS</b> (N effects inspected, coverage stated)</span>
          </div>
        </li>
      </ol>

      <p class="lifecycle-close">
        The human writes the law once; the law then governs every session,
        every model, every harness — one unbroken line.
      </p>
    </section>

    <section id="interview" class="article shell" aria-label="The ratification interview">
      <div class="article-rule"><span><b>Art. IV</b> — The interview</span></div>

      <div class="interview-grid">
        <div class="split-lead">
          <h2>No quick mode. <em>On purpose.</em></h2>
          <p class="prose">
            Ask for a one-shot constitution — “just generate it from the
            codebase” — and the skill declines. A document the model drafts is
            sampled from the very weights it exists to govern. Drift, dressed
            as law. Principles you never argued for are principles agents
            can’t use.
          </p>
          <p class="prose">
            So it interviews you. Open questions, one at a time, in your own
            words — never a menu of the interviewer’s priors. Every answer gets
            probed with the conflict that will eventually happen, because the
            gap between a value everyone claims and a principle that decides
            real trade-offs is exactly the drift you’re trying to kill.
          </p>

          <blockquote class="creed">
            <p>
              “Rigor over reach — at any price. There is no amount of lost
              adoption that buys a shortcut through deliberation. We accept,
              with eyes open, every user this costs.”
            </p>
            <cite>— Tension pair, this repository’s constitution</cite>
          </blockquote>
        </div>

        <figure class="transcript" aria-label="A condensed ratification exchange">
          <div class="turn">
            <span class="who">write-constitution</span>
            <p class="said">
              Twelve of your last twenty commits mention perf or benchmarks. Is
              raw speed a founding value — something you’d sacrifice features
              for — or a quality bar?
            </p>
          </div>
          <div class="turn you">
            <span class="who">You</span>
            <p class="said">
              Founding. Fewer fast features over more slow ones.
            </p>
          </div>
          <div class="turn">
            <span class="who">write-constitution</span>
            <p class="said">
              Then the probe: when performance conflicts with API simplicity,
              which wins?
            </p>
          </div>
          <div class="turn you">
            <span class="who">You</span>
            <p class="said">Simplicity. We’d find a different fast path.</p>
          </div>

          <div class="drafted">
            <span class="who">Drafted · awaiting your approval</span>
            <p>
              <strong>Speed is a feature, not a metric.</strong> Performance is
              a design constraint from the start — but never bought with API
              clarity. If the fast path is ugly, find a better path.
            </p>
            <p class="doc-rejects">
              Rejects: “optimize later” culture, benchmarks divorced from UX,
              APIs that leak implementation for throughput.
            </p>
            <div class="gate-chips">
              <span><b>✓</b> rejects something real</span>
              <span><b>✓</b> states its lean</span>
              <span><b>✓</b> decides a real case</span>
            </div>
          </div>
        </figure>
      </div>
    </section>

    <section id="evidence" class="article shell" aria-label="Evaluation evidence">
      <div class="article-rule"><span><b>Art. V</b> — The evidence</span></div>

      <div class="evidence-grid">
        <div class="split-lead">
          <h2>Adherence is <em>measured,</em> not assumed.</h2>
          <p class="prose">
            What you install is three skills, nothing else. The harness that
            proves them is this repository’s own lab: it drops real coding
            agents into a governed realm and applies pressure — useful requests
            hiding an unlawful effect, direct orders to cross a boundary,
            urgency, tampering, demands to skip the interview.
          </p>
          <p class="prose">
            Scenarios are checked deterministically on four axes — infra,
            correctness, adherence, ritual — with correctness scored by hidden
            tests the agent never sees, then A/B-tested against a bare control
            realm with no constitution and reviewed by a secondary model that
            never sees unfenced candidate output. Adherence in context is
            statistical, not guaranteed. That’s why it’s tested rather than
            trusted, and why the lab is public in the repo: the claim stays
            falsifiable.
          </p>
          <p class="evidence-notes">
            Run across frontier and open models through their real CLI
            harnesses. Over-refusal is a failure too: lawful work left undone
            scores against the run, so the law can’t hide behind blanket
            refusals.
          </p>
        </div>

        <figure class="term lab" aria-label="Evaluation scenarios">
          <figcaption class="term-bar">
            <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>evals/scenarios</span>
          </figcaption>
          <div class="term-body" tabindex="0">
            {scenarios.map(([id, gloss]) => (
              <div class="scenario">
                <span class="dim">{id}</span>
                <span>{gloss}</span>
              </div>
            ))}
            <div class="lab-axes">
              <span class="dim">axes:</span> infra · correctness · adherence · ritual<br />
              <span class="dim">condition:</span> constitution <span class="dim">vs</span> bare
              <span class="dim">(A/B)</span><br />
              <span class="dim">verdicts:</span> categorical — <span class="pass">never a numeric average</span>
            </div>
          </div>
        </figure>
      </div>
    </section>

    <section id="adopt" class="article shell" aria-label="Install the skills">
      <div class="article-rule"><span><b>Art. VI</b> — Adoption</span></div>

      <div class="adopt-lead">
        <h2>Two ways in. <em>One pen.</em></h2>
        <p class="prose">
          The skills are plain markdown. They run in Claude Code, Codex, Pi,
          or any harness that loads skills. Install them yourself, or hand the
          errand to an agent you already run. The one thing you can’t delegate
          is the interview: an agent can carry the law into the repo, but only
          you can write it.
        </p>
      </div>

      <div class="setup-grid">
        <figure class="term setup-term" aria-label="Setup by hand">
          <figcaption class="term-bar">
            <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>setup — by hand</span>
          </figcaption>
          <div class="term-body" tabindex="0">
            <span class="dim">$</span> git clone --depth 1 https://github.com/stefan-vatov/agentconstitution<br />
            <span class="dim">$</span> cp -r agentconstitution/skills/* .claude/skills/<br />
            <span class="dim">&nbsp;&nbsp;# codex → .codex/skills/ · every project → ~/.claude/skills/</span><br />
            <span class="dim">$</span> claude<br />
            <span class="pass">&gt;</span> write constitution
          </div>
        </figure>

        <figure class="prompt-card" aria-label="Setup by agent">
          <figcaption class="prompt-bar">
            <span>setup — by agent</span>
            <button class="copy-btn" type="button" data-copy="agent-setup-prompt">copy</button>
          </figcaption>
          <p class="prompt-text" id="agent-setup-prompt">
            Install the Agent Constitution skills from
            https://github.com/stefan-vatov/agentconstitution — shallow-clone
            the repo, copy skills/write-constitution, skills/constitution-decide,
            and skills/constitution-verify into this project’s skill directory
            (.claude/skills/, .codex/skills/, or equivalent), remove the clone,
            and confirm all three skills load. Do not begin ratification — the
            interview is mine to answer.
          </p>
          <p class="prompt-note">
            Paste into any agent session in your repo. Installation can be
            delegated; ratification cannot.
          </p>
        </figure>
      </div>

      <ol class="ratify-steps">
        <li>
          <h3>Answer honestly</h3>
          <p>
            The interview reads your codebase for signals, then asks open
            questions, one at a time, and probes every answer with the conflict
            that will eventually happen. Budget an hour.
          </p>
        </li>
        <li>
          <h3>Approve every word</h3>
          <p>
            Nothing enters the document without your yes, section by section,
            through the six adversarial gates. If you didn’t say it, it isn’t
            in there.
          </p>
        </li>
        <li>
          <h3>Let the law govern</h3>
          <p>
            The skill wires a digest into AGENTS.md and CLAUDE.md. From then
            on, agents steer by it before high-level choices and gate their own
            work against it, unprompted.
          </p>
        </li>
      </ol>
    </section>

    <aside class="meta-strip" aria-label="Self-governance note">
      <div class="shell">
        <RatifiedSeal class="seal-inline" />
        <p>
          <strong>This repository governs itself.</strong> Its
          <a
            class="inline-link"
            href="https://github.com/stefan-vatov/agentconstitution/blob/main/CONSTITUTION.md"
            target="_blank"
            rel="noopener"
            aria-label="Read the ratified CONSTITUTION.md (opens in a new tab)"
          >ratified constitution</a>
          is public, written through its own interview on 2026-08-05 by the
          project author. The skills that ship here are the skills that govern
          here, and the agent that built this page ended its report with a
          constitution line.
        </p>
      </div>
    </aside>

    <SiteFooter />
  </main>

  <script>
    const revertTimers = new WeakMap<HTMLButtonElement, number>();

    const swapLabel = (btn: HTMLButtonElement, text: string) => {
      btn.classList.add("is-swapping");
      setTimeout(() => {
        btn.textContent = text;
        btn.classList.remove("is-swapping");
      }, 130);
    };

    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const source = document.getElementById(btn.dataset.copy ?? "");
        if (!source) return;
        let label = "copied";
        try {
          await navigator.clipboard.writeText(source.innerText.trim());
        } catch {
          const range = document.createRange();
          range.selectNodeContents(source);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
          if (document.execCommand("copy")) {
            selection?.removeAllRanges();
          } else {
            label = "press ⌘C";
          }
        }
        swapLabel(btn, label);
        clearTimeout(revertTimers.get(btn));
        revertTimers.set(
          btn,
          window.setTimeout(() => swapLabel(btn, "copy"), 1900),
        );
      });
    });
  </script>
</BaseLayout>
