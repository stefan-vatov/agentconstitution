---
// Plate I — the tree of possibilities as an astral chart.
// A constellation of futures radiates from one origin star (no trunk:
// the first decision is a point, and many lines leave it). Bare: the
// whole sky is reachable and sampling sparks wander anywhere. Governed:
// two red boundary rays fence the lawful sector, constellations outside
// it ember and die at the crossing, and the direction-aligned paths
// brighten as sampling concentrates along them.
---

<figure class="tree-exhibit">
  <div class="plate">
    <div class="plate-bar">
      <span class="plate-label">Plate I — the tree of possibilities</span>
      <span class="term-ab" role="group" aria-label="Condition toggle">
        <span class="plate-dim">condition:</span>
        <button class="term-ab-btn" type="button" data-mode="0" aria-pressed="true">bare</button>
        <button class="term-ab-btn" type="button" data-mode="1" aria-pressed="false">governed</button>
      </span>
    </div>
    <div class="tree-body">
      <canvas
        class="tree-canvas"
        role="img"
        aria-label="An astral chart of project futures: constellations radiating from one origin star. Without the law, sampling wanders anywhere; with it, boundary rays fence a lawful sector and sampling concentrates along the direction."
      ></canvas>
    </div>
  </div>
  <figcaption class="plate-caption">
    The law removes branches — it never picks yours. Direction tilts what
    remains; inside the boundary, sampling runs free.
  </figcaption>
</figure>

<script>
  const exhibit = document.querySelector<HTMLElement>(".tree-exhibit");
  if (exhibit) {
    const canvas = exhibit.querySelector<HTMLCanvasElement>(".tree-canvas")!;
    const ctx = canvas.getContext("2d")!;
    const buttons = [...exhibit.querySelectorAll<HTMLButtonElement>(".term-ab-btn")];
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const css = getComputedStyle(document.documentElement);
    const token = (name: string, fallback: string) =>
      css.getPropertyValue(name).trim() || fallback;
    const STAR = token("--astral", "#c3d9e4");
    const BRIGHT = token("--astral-bright", "#ecf5fb");
    const DIM = token("--term-dim", "#948c74");
    const LAW = token("--seal-glow", "#cf5a41");

    const mulberry = (seed: number) => () => {
      seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };

    type Node = {
      x: number; y: number; depth: number; theta: number;
      parent: Node | null; forbidden: boolean; cut: boolean; emphasis: number;
      mag: number; phase: number; dist: number; cutDist: number;
    };
    type Path = { nodes: Node[]; cum: number[]; total: number };
    type BgStar = { x: number; y: number; r: number; a: number; tw: number; phase: number };

    let W = 0, H = 0, ox = 0, oy = 0;
    let nodes: Node[] = [], bgStars: BgStar[] = [];
    let lawfulPaths: Path[] = [], allPaths: Path[] = [];
    const SECTOR = 0.6;  // the lawful cone, radians from vertical
    const DIR = 0.14;    // the direction ray

    const build = () => {
      const rand = mulberry(20260805);
      nodes = []; bgStars = []; lawfulPaths = []; allPaths = [];
      ox = W / 2; oy = H - 44;
      const maxDepth = W < 560 ? 5 : 6;
      const leaves: Node[] = [];

      const origin: Node = {
        x: ox, y: oy, depth: 0, theta: 0, parent: null,
        forbidden: false, cut: false, emphasis: 1, mag: 3.4, phase: 0,
        dist: 0, cutDist: 0,
      };
      nodes.push(origin);

      const grow = (parent: Node, angle: number, depth: number, len: number) => {
        const x = parent.x + Math.sin(angle) * len;
        const y = parent.y - Math.cos(angle) * len;
        const theta = Math.atan2(x - ox, oy - y);
        const out = Math.abs(theta) > SECTOR;
        const node: Node = {
          x, y, depth, theta, parent,
          forbidden: parent.forbidden || out,
          cut: out && !parent.forbidden,
          emphasis: 0,
          mag: Math.max(0.9, 2.1 - depth * 0.24) + rand() * 0.5,
          phase: rand() * Math.PI * 2,
          dist: Math.hypot(x - ox, y - oy),
          cutDist: Math.hypot((x + parent.x) / 2 - ox, (y + parent.y) / 2 - oy),
        };
        nodes.push(node);
        if (depth >= maxDepth) { leaves.push(node); return; }
        const kids = rand() < 0.3 && depth < 3 ? 3 : 2;
        for (let i = 0; i < kids; i++) {
          const spread = 0.5 - depth * 0.05;
          const base = (i - (kids - 1) / 2) * spread;
          const jitter = (rand() - 0.5) * 0.3;
          const next = Math.max(-1.5, Math.min(1.5, angle + base + jitter));
          grow(node, next, depth + 1, len * 0.74);
        }
      };
      // no trunk: many first lines leave the origin star directly
      const rays = 5;
      for (let i = 0; i < rays; i++) {
        const a = -1.05 + (2.1 * i) / (rays - 1) + (rand() - 0.5) * 0.16;
        grow(origin, a, 1, H * 0.24);
      }

      for (const leaf of leaves) {
        const chain: Node[] = [];
        for (let n: Node | null = leaf; n; n = n.parent) chain.unshift(n);
        const cum = [0];
        for (let i = 1; i < chain.length; i++)
          cum.push(cum[i - 1] + Math.hypot(chain[i].x - chain[i - 1].x, chain[i].y - chain[i - 1].y));
        const path: Path = { nodes: chain, cum, total: cum[cum.length - 1] };
        allPaths.push(path);
        if (!leaf.forbidden) lawfulPaths.push(path);
      }
      const scored = lawfulPaths
        .map((p) => ({ p, d: Math.abs(p.nodes[p.nodes.length - 1].theta - DIR) }))
        .sort((a, b) => a.d - b.d);
      scored.slice(0, Math.max(3, Math.floor(scored.length * 0.16))).forEach(({ p }) => {
        for (const n of p.nodes) n.emphasis = 1;
      });

      // the sky behind the futures
      const starCount = Math.floor((W * H) / 9000);
      for (let i = 0; i < starCount; i++) {
        bgStars.push({
          x: rand() * W, y: rand() * (H - 60),
          r: 0.4 + rand() * 0.8,
          a: 0.05 + rand() * 0.16,
          tw: rand() < 0.14 ? 0.5 + rand() * 0.8 : 0,
          phase: rand() * Math.PI * 2,
        });
      }
    };

    // ---- animation state ----
    let mode = 0, g = 0, growT = reduce ? 1 : 0;
    let interacted = false, nextFlip = -1, clock = 0;
    type Spark = { path: Path; t: number; speed: number; fade: number; dying?: boolean };
    let sparks: Spark[] = [];
    const pulseRand = mulberry(7);

    const pickPath = () => {
      if (mode === 1) {
        const pool = lawfulPaths.filter((p) => p.nodes[p.nodes.length - 1].emphasis || pulseRand() < 0.22);
        return pool[Math.floor(pulseRand() * pool.length)] ?? lawfulPaths[0];
      }
      return allPaths[Math.floor(pulseRand() * allPaths.length)];
    };
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const clamp01 = (t: number) => Math.max(0, Math.min(1, t));
    const easeOut = (t: number) => 1 - (1 - t) ** 3;
    const easeInOut = (t: number) =>
      t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2;

    const ray = (angle: number, r0: number, r1: number) => {
      ctx.beginPath();
      ctx.moveTo(ox + Math.sin(angle) * r0, oy - Math.cos(angle) * r0);
      ctx.lineTo(ox + Math.sin(angle) * r1, oy - Math.cos(angle) * r1);
      ctx.stroke();
    };

    const draw = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      ctx.lineCap = "round";
      const maxDepth = Math.max(...nodes.map((n) => n.depth));
      const reach = H - 70;
      // judgment radiates from inception: a wavefront that fences, severs,
      // and ignites as it passes — and retracts the same way it came
      const judgeR = easeInOut(g) * (reach + 60);

      // the sky
      for (const s of bgStars) {
        const tw = s.tw ? 0.6 + 0.4 * Math.sin(clock * 0.0011 * s.tw + s.phase) : 1;
        ctx.globalAlpha = s.a * tw;
        ctx.fillStyle = STAR;
        ctx.beginPath(); ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2); ctx.fill();
      }

      // the law: two boundary rays drawing outward with the wavefront
      if (judgeR > 27) {
        const lawA = clamp01(judgeR / 90);
        const rayEnd = Math.min(reach, judgeR);
        ctx.strokeStyle = LAW;
        ctx.lineWidth = 1;
        ctx.setLineDash([2, 6]);
        ctx.globalAlpha = lawA * 0.55;
        ray(-SECTOR, 26, rayEnd);
        ray(SECTOR, 26, rayEnd);
        ctx.setLineDash([]);
        // labels and direction arrive when the front does
        const arrived = clamp01((judgeR - reach * 0.9) / (reach * 0.12));
        ctx.font = "10px ui-monospace, Menlo, monospace";
        if (arrived > 0) {
          ctx.fillStyle = LAW;
          ctx.globalAlpha = arrived * 0.75;
          const bx = (a: number) => ox + Math.sin(a) * (reach + 6);
          const by = (a: number) => oy - Math.cos(a) * (reach + 6);
          ctx.textAlign = "right";
          ctx.fillText("boundary", bx(-SECTOR) - 4, by(-SECTOR) + 12);
          ctx.textAlign = "left";
          ctx.fillText("boundary", bx(SECTOR) + 4, by(SECTOR) + 12);
        }
        ctx.globalAlpha = lawA * 0.3;
        ctx.strokeStyle = BRIGHT;
        ray(DIR, 26, Math.min(reach * 0.94, judgeR));
        if (arrived > 0) {
          const dx = ox + Math.sin(DIR) * (reach * 0.94);
          const dy = oy - Math.cos(DIR) * (reach * 0.94);
          ctx.globalAlpha = arrived * 0.8;
          ctx.lineWidth = 1.3;
          for (let i = 0; i < 3; i++) {
            const y = dy - 4 - i * 6;
            ctx.beginPath();
            ctx.moveTo(dx - 4.5, y + 4.5); ctx.lineTo(dx, y); ctx.lineTo(dx + 4.5, y + 4.5);
            ctx.stroke();
          }
          if (W > 560) {
            ctx.fillStyle = BRIGHT;
            ctx.globalAlpha = arrived * 0.6;
            ctx.fillText("direction", dx + 10, dy - 8);
          }
        }
      }

      // constellation lines
      for (const n of nodes) {
        if (!n.parent) continue;
        const t0 = (n.depth - 1) / maxDepth;
        const t1 = n.depth / maxDepth;
        const local = easeOut(clamp01((growT - t0) / (t1 - t0)));
        if (local <= 0) continue;
        const ex = lerp(n.parent.x, n.x, local);
        const ey = lerp(n.parent.y, n.y, local);
        const ghost = n.forbidden ? clamp01((judgeR - n.dist) / 60) : 0;
        const emph = n.emphasis * clamp01((judgeR - n.dist) / 90);
        ctx.strokeStyle = emph > 0 ? BRIGHT : ghost > 0.5 ? LAW : STAR;
        ctx.globalAlpha = Math.max(0.04, lerp(0.34 - n.depth * 0.028, 0.07, ghost) + emph * 0.42);
        ctx.lineWidth = lerp(0.7, 1.5, emph);
        ctx.beginPath(); ctx.moveTo(n.parent.x, n.parent.y); ctx.lineTo(ex, ey); ctx.stroke();

        // severed at the crossing: the slash lands as the front passes it
        const cutA = n.cut ? clamp01((judgeR - n.cutDist) / 40) : 0;
        if (cutA > 0) {
          const mx = (n.parent.x + n.x) / 2;
          const my = (n.parent.y + n.y) / 2;
          const a = Math.atan2(n.x - n.parent.x, n.parent.y - n.y) + Math.PI / 2;
          ctx.strokeStyle = LAW;
          ctx.globalAlpha = cutA * 0.9;
          ctx.lineWidth = 1.4;
          ctx.beginPath();
          ctx.moveTo(mx - Math.sin(a) * 4, my + Math.cos(a) * 4);
          ctx.lineTo(mx + Math.sin(a) * 4, my - Math.cos(a) * 4);
          ctx.stroke();
        }
      }

      // the stars themselves — each ignites as its line arrives
      for (const n of nodes) {
        const t1 = n.depth / Math.max(1, maxDepth);
        const rev = easeOut(clamp01((growT - t1 + 0.03) / 0.08));
        if (rev <= 0) continue;
        const ghost = n.forbidden ? clamp01((judgeR - n.dist) / 60) : 0;
        const emph = n.emphasis * clamp01((judgeR - n.dist) / 90);
        const tw = n.depth >= maxDepth - 1 && !reduce
          ? 0.75 + 0.25 * Math.sin(clock * 0.0013 + n.phase)
          : 1;
        const alpha = Math.max(0.08, lerp(0.85, 0.16, ghost)) * tw * rev;
        const r = (n.mag * lerp(1, 0.72, ghost) + emph * 0.9) * (0.55 + 0.45 * rev);
        const glow = n.depth === 0 || emph > 0.05;
        const col = emph > 0 || n.depth === 0 ? BRIGHT : ghost > 0.5 ? LAW : STAR;
        ctx.globalAlpha = alpha;
        ctx.fillStyle = col;
        if (glow) {
          ctx.shadowColor = col;
          ctx.shadowBlur = n.depth === 0 ? 14 : 4 + emph * 8;
        }
        ctx.beginPath(); ctx.arc(n.x, n.y, r, 0, Math.PI * 2); ctx.fill();
        if (glow) ctx.shadowBlur = 0;
      }

      // the ding: a soft ring leaving the origin star
      if (!reduce && growT >= 1) {
        const cycle = (clock % 4200) / 4200;
        if (cycle < 0.34) {
          const kE = easeOut(cycle / 0.34);
          ctx.globalAlpha = (1 - kE) * 0.4;
          ctx.strokeStyle = BRIGHT;
          ctx.lineWidth = 1;
          ctx.beginPath(); ctx.arc(ox, oy, 6 + kE * 40, 0, Math.PI * 2); ctx.stroke();
        }
      }

      // sampling sparks — constant velocity along the constellation line
      for (const s of sparks) {
        const chain = s.path.nodes;
        const dist = s.t * s.path.total;
        let i = 0;
        while (i < chain.length - 2 && s.path.cum[i + 1] < dist) i++;
        const segLen = Math.max(0.001, s.path.cum[i + 1] - s.path.cum[i]);
        const local = clamp01((dist - s.path.cum[i]) / segLen);
        const px = lerp(chain[i].x, chain[i + 1].x, local);
        const py = lerp(chain[i].y, chain[i + 1].y, local);
        const leaf = chain[chain.length - 1];
        const envelope = Math.min(1, s.t / 0.08, (1 - s.t) / 0.1);
        const col = mode === 0 && leaf.forbidden && s.t > 0.55 ? LAW : BRIGHT;
        ctx.globalAlpha = 0.95 * s.fade * Math.max(0, envelope);
        ctx.fillStyle = col;
        ctx.shadowColor = col;
        ctx.shadowBlur = 9;
        ctx.beginPath(); ctx.arc(px, py, 1.7, 0, Math.PI * 2); ctx.fill();
        ctx.shadowBlur = 0;
        if (s.t > 0.96 && leaf.forbidden && mode === 0) {
          ctx.globalAlpha = (1 - s.t) * 10 * s.fade;
          ctx.strokeStyle = LAW;
          ctx.lineWidth = 1;
          ctx.beginPath(); ctx.arc(leaf.x, leaf.y, 6, 0, Math.PI * 2); ctx.stroke();
        }
      }

      // origin label
      ctx.globalAlpha = 0.75;
      ctx.fillStyle = DIM;
      ctx.font = "10px ui-monospace, Menlo, monospace";
      ctx.textAlign = "left";
      ctx.fillText("inception", ox + 12, oy + 4);
      ctx.globalAlpha = 1;
    };

    // ---- loop ----
    let raf = 0, last = 0, running = false;
    const frame = (now: number) => {
      const dt = Math.min(50, now - (last || now));
      last = now;
      clock += dt;
      if (growT < 1) growT = Math.min(1, growT + dt / 1600);
      // the demonstration runs itself: the condition flips every few
      // seconds until the visitor takes the toggle
      if (!interacted && growT >= 1) {
        if (nextFlip < 0) nextFlip = clock + 2600;
        else if (clock >= nextFlip) {
          setMode(mode === 0 ? 1 : 0);
          nextFlip = clock + 4200;
        }
      }
      const target = mode;
      if (g !== target) {
        const step = dt / 950;
        g = target > g ? Math.min(target, g + step) : Math.max(target, g - step);
      }
      const alive = sparks.filter((s) => !s.dying).length;
      if (growT >= 1 && alive < 3 && pulseRand() < dt / 620) {
        if (allPaths.length)
          sparks.push({ path: pickPath(), t: 0, speed: 0.00036 + pulseRand() * 0.0002, fade: 1 });
      }
      sparks = sparks.filter((s) => {
        s.t += s.speed * dt;
        if (s.dying) s.fade = Math.max(0, s.fade - dt / 240);
        return s.t < 1 && s.fade > 0;
      });
      draw();
      if (running) raf = requestAnimationFrame(frame);
    };

    const start = () => {
      if (running || reduce) return;
      running = true; last = 0;
      raf = requestAnimationFrame(frame);
    };
    const stop = () => { running = false; cancelAnimationFrame(raf); };

    const setMode = (m: number) => {
      mode = m;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(Number(b.dataset.mode) === m)));
      // sparks from the old condition dim out instead of vanishing
      sparks.forEach((s) => (s.dying = true));
      if (reduce) { g = m; growT = 1; sparks = []; draw(); }
    };
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        interacted = true;
        setMode(Number(b.dataset.mode));
      }),
    );

    const resize = () => {
      const rect = canvas.parentElement!.getBoundingClientRect();
      const dpr = Math.min(devicePixelRatio || 1, 2);
      W = rect.width;
      H = Math.max(300, Math.min(460, rect.width * 0.42));
      canvas.style.height = `${H}px`;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      build();
      draw();
    };
    new ResizeObserver(resize).observe(canvas.parentElement!);
    resize();

    if (reduce) {
      setMode(1);
    } else {
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => (e.isIntersecting ? start() : stop())),
        { threshold: 0.15 },
      );
      io.observe(exhibit);
      document.addEventListener("visibilitychange", () =>
        document.hidden ? stop() : start(),
      );
    }
  }
</script>
