---
interface Props {
  class?: string;
}

const { class: className = "seal" } = Astro.props;
const uid = `seal-ring-${crypto.randomUUID().slice(0, 8)}`;
const nibUid = `seal-nib-${crypto.randomUUID().slice(0, 8)}`;
---

<svg
  class={className}
  viewBox="0 0 150 150"
  role="img"
  aria-label="Ratified 2026-08-05 by the project author"
>
  <defs>
    <path
      id={uid}
      d="M75 75 m -53 0 a 53 53 0 1 1 106 0 a 53 53 0 1 1 -106 0"
    ></path>
  </defs>
  <circle cx="75" cy="75" r="71" fill="none" stroke="currentColor" stroke-width="2.5"></circle>
  <circle cx="75" cy="75" r="64.5" fill="none" stroke="currentColor" stroke-width="1"></circle>
  <circle cx="75" cy="75" r="41" fill="none" stroke="currentColor" stroke-width="1"></circle>
  <text
    fill="currentColor"
    font-family="ui-monospace, 'SF Mono', Menlo, monospace"
    font-size="10.2"
    font-weight="600"
    letter-spacing="2.6"
  >
    <textPath href={`#${uid}`}>RATIFIED · 2026-08-05 · BY THE PROJECT AUTHOR ·</textPath>
  </text>
  <g transform="translate(53.75, 48.55) scale(0.425)">
    <mask id={nibUid} maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="132">
      <rect width="100" height="132" fill="white"></rect>
      <circle cx="50" cy="50" r="8.4" fill="black"></circle>
      <rect x="48.2" y="50" width="3.6" height="68" fill="black"></rect>
    </mask>
    <path
      mask={`url(#${nibUid})`}
      fill="currentColor"
      d="M 22 21 Q 50 12 78 21 L 78 34 C 78 44 76 50 74 56 C 66 74 55 90 50 110 C 45 90 34 74 26 56 C 24 50 22 44 22 34 Z"
    ></path>
  </g>
</svg>
