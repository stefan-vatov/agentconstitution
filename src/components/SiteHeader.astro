---
interface Props {
  /** Prefix for section anchors — "" on the index page, "/" elsewhere. */
  root?: string;
}

const { root = "" } = Astro.props;
const onMechanism = Astro.url.pathname.replace(/\/$/, "") === "/how-it-works";
---

<header class="site-header" aria-label="Primary">
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="shell">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="22 12 56 98" width="11" height="19">
          <path fill="var(--paper-high)" d="M 22 21 Q 50 12 78 21 L 78 34 C 78 44 76 50 74 56 C 66 74 55 90 50 110 C 45 90 34 74 26 56 C 24 50 22 44 22 34 Z"/>
          <circle cx="50" cy="50" r="8.4" fill="var(--seal)"/>
          <rect x="48.2" y="50" width="3.6" height="68" fill="var(--seal)"/>
        </svg>
      </span>
      <span class="brand-name">Agent Constitution</span>
    </a>
    <nav class="site-nav" aria-label="Site">
      <a href={`${root}#drift`}>The drift</a>
      <a href={`${root}#document`}>The document</a>
      <a href={`${root}#lifecycle`}>Lifecycle</a>
      <a href={`${root}#evidence`}>Evidence</a>
      <a href="/how-it-works" aria-current={onMechanism ? "page" : undefined}>
        Mechanism
      </a>
      <a
        href="https://github.com/stefan-vatov/agentconstitution"
        target="_blank"
        rel="noopener"
        aria-label="GitHub repository (opens in a new tab)"
      >
        GitHub <span aria-hidden="true">↗</span>
      </a>
      <a class="nav-cta" href={`${root}#adopt`}>Install</a>
    </nav>
  </div>
</header>
