---
// Fig. I — the drift, printed on the paper itself.
// Four sessions set out together on the same bearing (a dashed chart
// annotation, not a promised route — and not the law: no red ink exists
// in Art. I's lawless world). Each peels off in its own direction at its
// own moment, arcs, and settles into the same gray stratum: the average
// of all the weights. The truest walk lands directly below the point,
// so the deficit reads as a plumb-line gap. Knots are designed, wobble
// is seeded — every visitor reads the same printed figure.

const mulberry = (seed: number) => () => {
  seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

const r1 = (v: number) => Math.round(v * 10) / 10;

const smoothPath = (pts: number[][]) => {
  let d = `M${r1(pts[0][0])} ${r1(pts[0][1])}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[Math.max(0, i - 1)];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[Math.min(pts.length - 1, i + 2)];
    d += ` C${r1(p1[0] + (p2[0] - p0[0]) / 6)} ${r1(p1[1] + (p2[1] - p0[1]) / 6)}, ${r1(p2[0] - (p3[0] - p1[0]) / 6)} ${r1(p2[1] - (p3[1] - p1[1]) / 6)}, ${r1(p2[0])} ${r1(p2[1])}`;
  }
  return d;
};

const rand = mulberry(6011);
const jit = (v: number, amp = 3) => v + (rand() - 0.5) * 2 * amp;

const origin = { x: 64, y: 452 };
const ring = { x: 452, y: 84 };
const band = { x: 44, y: 348, w: 462, h: 66 };

// the dashed bearing stops short of the ring — an annotation, not an arrival
const bearingEnd = {
  x: origin.x + (ring.x - origin.x) * 0.955,
  y: origin.y + (ring.y - origin.y) * 0.955,
};

// knots: [shared start on the bearing] then [departure, apex, sag, landing]
const knotSets: number[][][] = [
  [[64, 452], [jit(111), jit(408)], [jit(157), jit(364)], [jit(198), jit(300)], [jit(218), jit(356)], [236, 396]],
  [[64, 452], [jit(111), jit(408)], [jit(157), jit(364)], [jit(180), jit(342)], [jit(255), jit(262)], [jit(292), jit(330)], [312, 388]],
  [[64, 452], [jit(111), jit(408)], [jit(157), jit(364)], [jit(204), jit(320)], [jit(322), jit(246)], [jit(368), jit(320)], [392, 384]],
  [[64, 452], [jit(111), jit(408)], [jit(157), jit(364)], [jit(235), jit(290)], [jit(402), jit(208)], [jit(438), jit(300)], [452, 374]],
];

const walks = knotSets.map((pts) => ({
  d: smoothPath(pts),
  dots: pts.slice(1, -1).map(([x, y]) => ({ x: r1(x), y: r1(y) })),
  end: { x: pts[pts.length - 1][0], y: pts[pts.length - 1][1] },
}));
---

<figure class="drift-fig">
  <svg
    viewBox="34 66 492 408"
    role="img"
    aria-label="Four smooth paths set out together along a dashed bearing aimed at a distant ring labeled the point. One by one they peel away, arc in their own directions, and all settle into a gray horizontal band labeled the training prior. The truest path ends directly below the ring, far beneath it."
  >
    <defs>
      <linearGradient id="fig-band-fade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#211d15" stop-opacity="0"></stop>
        <stop offset="0.3" stop-color="#211d15" stop-opacity="0.07"></stop>
        <stop offset="0.7" stop-color="#211d15" stop-opacity="0.07"></stop>
        <stop offset="1" stop-color="#211d15" stop-opacity="0"></stop>
      </linearGradient>
    </defs>

    <rect class="fig-late fig-band" x={band.x} y={band.y} width={band.w} height={band.h} fill="url(#fig-band-fade)"></rect>

    <line
      class="fig-mid fig-bearing"
      x1={origin.x} y1={origin.y}
      x2={r1(bearingEnd.x)} y2={r1(bearingEnd.y)}
    ></line>
    <circle class="fig-mid fig-point" cx={ring.x} cy={ring.y} r="4.5"></circle>
    <text class="fig-mid fig-label" x={ring.x - 12} y={ring.y + 4} text-anchor="end">the point</text>

    {walks.map((walk, i) => (
      <g class="fig-walk-g" style={`--i: ${i}`}>
        <path class="fig-walk" d={walk.d} pathLength="1"></path>
        {walk.dots.map((dot) => (
          <circle class="fig-late fig-step" cx={dot.x} cy={dot.y} r="1.3"></circle>
        ))}
        <circle class="fig-late fig-end" cx={walk.end.x} cy={walk.end.y} r="2.3"></circle>
      </g>
    ))}

    <circle class="fig-origin" cx={origin.x} cy={origin.y} r="3.2"></circle>
    <text class="fig-label" x={origin.x + 12} y={origin.y + 4}>the reasons</text>
    <text class="fig-late fig-label" x={band.x + band.w - 4} y={band.y + band.h - 10} text-anchor="end">
      the training prior
    </text>
  </svg>
  <figcaption class="fig-caption">
    Fig. I. Four sessions set out on the same bearing; every step is locally
    correct. Each drifts by its own prior, and every session settles into the
    training prior: the average of all the weights.
  </figcaption>
</figure>

<script>
  const fig = document.querySelector<HTMLElement>(".drift-fig");
  if (fig && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    // hidden-then-drawn only when JS runs — without it the figure is
    // simply printed, fully visible
    fig.classList.add("will-draw");
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            fig.classList.add("is-drawn");
            io.disconnect();
          }
        }),
      { threshold: 0.35 },
    );
    io.observe(fig);
  }
</script>
