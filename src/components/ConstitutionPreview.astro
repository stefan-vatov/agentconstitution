---
import {
  CircleCheck,
  GitBranch,
  GitPullRequest,
  ShieldCheck,
  Sparkles,
} from "@lucide/astro";
---

<figure class="preview" aria-label="A constitution review interface preview">
  <div class="preview-toolbar">
    <div class="window-controls" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <span class="file-name">CONSTITUTION.md</span>
    <span class="status">Ratified</span>
  </div>

  <div class="preview-grid">
    <section class="document-pane" aria-label="Constitution excerpt">
      <div class="section-label">Article II</div>
      <h2>Pruning Function</h2>
      <p>
        This project preserves coherence by rejecting changes that expand capability
        while weakening judgment.
      </p>

      <div class="principle-list">
        <div class="principle">
          <ShieldCheck size={16} />
          <span>Prefer durable architecture over clever local wins.</span>
        </div>
        <div class="principle">
          <GitBranch size={16} />
          <span>New branches must preserve the product's operating thesis.</span>
        </div>
        <div class="principle">
          <Sparkles size={16} />
          <span>Agents may propose novelty, but must defend alignment.</span>
        </div>
      </div>
    </section>

    <aside class="gate-pane" aria-label="Ratification quality gates">
      <div class="gate-heading">
        <GitPullRequest size={17} />
        <span>Alignment Gate</span>
      </div>

      <div class="score">
        <span>92</span>
        <small>/100</small>
      </div>

      <ul>
        <li>
          <CircleCheck size={15} />
          <span>Passes Motherhood Test</span>
        </li>
        <li>
          <CircleCheck size={15} />
          <span>Prunes an actual tradeoff</span>
        </li>
        <li>
          <CircleCheck size={15} />
          <span>Resolves agent ambiguity</span>
        </li>
      </ul>
    </aside>
  </div>
</figure>
